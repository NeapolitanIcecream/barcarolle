{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://barcarolle.local/schemas/agent_tuning_demo/tuning_artifact.schema.json",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+$",
      "type": "string"
    },
    "artifact_type": {
      "enum": [
        "agents_md_appendix",
        "skill_md",
        "kilo_rule",
        "policy_snippet"
      ],
      "type": "string"
    },
    "changed_files": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "created_at": {
      "type": "string"
    },
    "files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "type": "string"
          },
          "workspace_relative_path": {
            "minLength": 1,
            "type": "string"
          },
          "write_mode": {
            "default": "create_or_replace",
            "enum": [
              "create_or_replace",
              "append"
            ],
            "type": "string"
          }
        },
        "required": [
          "workspace_relative_path",
          "content"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "hash": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "holdout_derived": {
      "type": "boolean"
    },
    "intended_effect": {
      "minLength": 1,
      "type": "string"
    },
    "optimizer_source": {
      "minLength": 1,
      "type": "string"
    },
    "rollback_plan": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "barcarolle.agent_tuning_demo.tuning_artifact.v1",
      "type": "string"
    },
    "target_agent": {
      "enum": [
        "codex_workspace",
        "kilo_workspace",
        "any_workspace_agent"
      ],
      "type": "string"
    },
    "visible_to_optimizer": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "artifact_type",
    "target_agent",
    "changed_files",
    "files",
    "hash",
    "intended_effect",
    "rollback_plan",
    "optimizer_source",
    "visible_to_optimizer",
    "holdout_derived"
  ],
  "title": "Barcarolle Agent Tuning Artifact",
  "type": "object"
}
