{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "cells": {
      "items": {
        "properties": {
          "adapter_id": {
            "type": "string"
          },
          "comparison_label": {
            "const": "same_endpoint_model_different_cli_harnesses"
          },
          "harness_name": {
            "type": "string"
          },
          "policy_violation": {
            "type": "boolean"
          },
          "repo_id": {
            "enum": [
              "toolz",
              "humanize",
              "click"
            ]
          },
          "score": {
            "type": [
              "number",
              "null"
            ]
          },
          "scoreable_cell": {
            "type": "boolean"
          },
          "source_result_prefix": {
            "type": "string"
          },
          "split": {
            "enum": [
              "B_real",
              "W_real",
              "G_mini"
            ]
          },
          "task_id": {
            "type": "string"
          },
          "terminal_status": {
            "type": "string"
          }
        },
        "required": [
          "source_result_prefix",
          "repo_id",
          "task_id",
          "split",
          "adapter_id",
          "harness_name",
          "terminal_status",
          "scoreable_cell",
          "policy_violation",
          "score"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "claim_scope": {
      "const": "phase1_mvp_compiler_infrastructure"
    },
    "comparison_label": {
      "const": "same_endpoint_model_different_cli_harnesses"
    },
    "predictive_validity_established": {
      "const": false
    },
    "schema_version": {
      "const": "barcarolle.phase1.workspace_scorecard.v1"
    }
  },
  "required": [
    "schema_version",
    "claim_scope",
    "comparison_label",
    "predictive_validity_established",
    "cells",
    "summary",
    "disallowed_claims"
  ],
  "title": "Barcarolle Phase 1 Workspace Scorecard",
  "type": "object"
}
