{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "claim_scope": {
      "const": "phase1_mvp_compiler_infrastructure"
    },
    "disallowed_claims": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "gate_order": {
      "items": {
        "enum": [
          "checkout",
          "oracle_extractable",
          "no_op_fail",
          "reference_pass",
          "known_bad_fail",
          "flakiness_check",
          "ambiguity_review",
          "solution_leakage_review",
          "scope_clarity_review",
          "cost_boundedness",
          "taxonomy_labelability"
        ]
      },
      "type": "array"
    },
    "predictive_validity_established": {
      "const": false
    },
    "repos": {
      "items": {
        "properties": {
          "certified_count": {
            "minimum": 0,
            "type": "integer"
          },
          "first_failing_gate_counts": {
            "type": "object"
          },
          "gate_counts": {
            "type": "object"
          },
          "near_certified_count": {
            "minimum": 0,
            "type": "integer"
          },
          "rejected_count": {
            "minimum": 0,
            "type": "integer"
          },
          "repo_id": {
            "type": "string"
          },
          "status_counts": {
            "type": "object"
          }
        },
        "required": [
          "repo_id",
          "status_counts",
          "certified_count",
          "near_certified_count",
          "rejected_count",
          "first_failing_gate_counts",
          "gate_counts"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "barcarolle.phase1.certification_rollup.v1"
    },
    "source_weaknesses": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "claim_scope",
    "predictive_validity_established",
    "repos",
    "gate_order",
    "source_weaknesses",
    "disallowed_claims"
  ],
  "title": "Barcarolle Phase 1 Certification Rollup",
  "type": "object"
}
