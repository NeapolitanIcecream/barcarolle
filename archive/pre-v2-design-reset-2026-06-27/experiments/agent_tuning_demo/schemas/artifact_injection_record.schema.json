{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://barcarolle.local/schemas/agent_tuning_demo/artifact_injection_record.schema.json",
  "additionalProperties": false,
  "properties": {
    "artifact_hash": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "artifact_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+$",
      "type": "string"
    },
    "cleanup_policy": {
      "enum": [
        "workspace_discarded_after_run",
        "delete_before_verifier_replay",
        "manual_local_only"
      ],
      "type": "string"
    },
    "injected_at": {
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "barcarolle.agent_tuning_demo.artifact_injection_record.v1",
      "type": "string"
    },
    "surface": {
      "minLength": 1,
      "type": "string"
    },
    "target_agent": {
      "enum": [
        "codex_workspace",
        "kilo_workspace",
        "any_workspace_agent"
      ],
      "type": "string"
    },
    "workspace_relative_paths": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "artifact_id",
    "artifact_hash",
    "target_agent",
    "surface",
    "workspace_relative_paths",
    "injected_at",
    "cleanup_policy"
  ],
  "title": "Barcarolle Agent Tuning Artifact Injection Record",
  "type": "object"
}
